{
	"name": "celemas/wire",
	"description": "Autowiring object creator and argument resolver",
	"type": "library",
	"keywords": [
		"celemas",
		"autowire",
		"autowiring",
		"factory",
		"ioc"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Ernst",
			"email": "ernst@celemas.dev"
		}
	],
	"homepage": "https://celemas.dev/wire",
	"autoload": {
		"psr-4": {
			"Celemas\\Wire\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Celemas\\Wire\\Tests\\": "tests"
		}
	},
	"require": {
		"php": "^8.5",
		"psr/container": "^2.0"
	},
	"require-dev": {
		"celemas/dev": "^3.0"
	},
	"scripts": {
		"test": "./vendor/bin/phpunit --testdox --no-coverage --colors=always",
		"docstest": "./vendor/bin/docs-test-runner ./docs/code",
		"types": "./vendor/bin/psalm --no-cache",
		"mdlint": "markdownlint-cli2 README.md CHANGELOG.md LICENSE.md docs/",
		"lint": [
			"./vendor/bin/mago fmt --check",
			"./vendor/bin/mago lint"
		],
		"coverage": [
			"./vendor/bin/phpunit --testdox --path-coverage --coverage-text --coverage-php=.coverage/cover.php --colors=always",
			"./vendor/bin/coverlyzer .coverage/cover.php"
		],
		"ci": [
			"composer lint",
			"composer docstest",
			"composer coverage",
			"composer types",
			"composer mdlint"
		]
	}
}
